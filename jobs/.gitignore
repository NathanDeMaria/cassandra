# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# tfvars can carry account-specific values; terraform.tfvars.example is the
# checked-in template.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files are for local experiments
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
